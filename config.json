# Default configuration for 42 Pac-Man
# Comments starting with '#' are stripped automatically by ConfigLoader
{
    # Highscore storage path
    "highscore_filename": "highscores.json",

    # Starting player lives
    "lives": 3,

    # Scoring values
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,

    # Base time limit per level in seconds
    "level_max_time": 90,

    # Deterministic seed for Level 1
    "seed": 42,

    # 10 campaign levels with progressive dimensions
    "levels": [
        {"level": 1, "width": 15, "height": 15, "max_time": 90},
        {"level": 2, "width": 15, "height": 15, "max_time": 90},
        {"level": 3, "width": 17, "height": 17, "max_time": 85},
        {"level": 4, "width": 17, "height": 17, "max_time": 85},
        {"level": 5, "width": 19, "height": 19, "max_time": 80},
        {"level": 6, "width": 19, "height": 19, "max_time": 80},
        {"level": 7, "width": 21, "height": 21, "max_time": 75},
        {"level": 8, "width": 21, "height": 21, "max_time": 75},
        {"level": 9, "width": 23, "height": 23, "max_time": 70},
        {"level": 10, "width": 25, "height": 25, "max_time": 70}
    ]
}
