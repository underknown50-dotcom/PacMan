# =============================================================================
# 42 Curriculum Pac-Man: .gitignore
# Excludes Python artifacts, virtual environments, caches, and build outputs.
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.so

# Virtual environments (PEP 405)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Type checker, test & coverage caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# Build and Distribution artifacts (Chapter 7)
build/
dist/
release/
*.egg-info/
*.egg
!pacman.spec

# Runtime & User-generated state
highscores.json
*.log
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Local study & defense notes
*DEFENSE*.md
*defense*.md
